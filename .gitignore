# Datasets: raw PPG-DaLiA recordings and processed participant windows stay local
data/raw/
data/processed/

# Python environments and caches
.venv/
venv/
env/
.local_python/
__pycache__/
*.py[cod]
.pytest_cache/

# Jupyter temporary files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Credentials and local configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# System files and logs
.DS_Store
*.log

